rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'scrutinyacademy@gmail.com';
    }

    match /students/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.accessStatus == 'pending'
        && request.resource.data.paymentStatus == 'not_submitted'
        && request.resource.data.accessPrice == 59;

      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Students can edit only harmless profile details. Payment/access fields are server-controlled.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.accessStatus == resource.data.accessStatus
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.accessPrice == resource.data.accessPrice
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /paymentRequests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
