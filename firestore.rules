rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && (request.auth.token.founder == true || request.auth.token.email in ['scrutinyacademy@gmail.com','iampramodsharma02@gmail.com']); }
    function isFounder() { return signedIn() && request.auth.token.founder == true; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function hasClass10Access() {
      let student = get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
      return signedIn() && (isFounder()
        || (student.courseEntitlements is map
          && 'class10' in student.courseEntitlements
          && student.courseEntitlements.class10.status == 'active')
        || (student.accessStatus == 'active'
          && (student.purchasedCourse == 'class10' || student.requestedCourse == 'class10' || student.activeCourse == 'class10')));
    }
    function hasMissionEntitlement(resourceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/mission600Entitlements/$(request.auth.uid + '_' + resourceId))
        && get(/databases/$(database)/documents/mission600Entitlements/$(request.auth.uid + '_' + resourceId)).data.status == 'active';
    }
    function hasActiveAccess() {
      return signedIn() && (isAdmin() || get(/databases/$(database)/documents/students/$(request.auth.uid)).data.accessStatus == 'active');
    }
    function hasNeetssAccess() {
      let student = get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
      return signedIn() && (isAdmin() || (student.courseEntitlements is map
        && 'neetss' in student.courseEntitlements
        && student.courseEntitlements.neetss.status == 'active'));
    }

    match /students/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.accessStatus == 'pending'
        && request.resource.data.paymentStatus == 'not_submitted'
        && request.resource.data.requestedCourse in ['class6','class8','class10','class11','class12','neet','jee','mbbs','neetss']
        && request.resource.data.activeCourse == request.resource.data.requestedCourse
        && request.resource.data.enrolledCourses is list
        && request.resource.data.enrolledCourses.size() == 0
        && request.resource.data.courseEntitlements is map
        && request.resource.data.courseEntitlements.size() == 0
        && ((request.resource.data.requestedCourse == 'class6'
          && request.resource.data.accessPrice is int
          && request.resource.data.accessPrice >= 49
          && request.resource.data.accessPrice <= 2484
          && request.resource.data.class6Months is int
          && request.resource.data.class6Months >= 1
          && request.resource.data.class6Months <= 12
          && request.resource.data.class6Subjects is list
          && request.resource.data.class6Subjects.size() >= 1
          && request.resource.data.class6Subjects.size() <= 3
          && request.resource.data.class6Subjects.hasOnly(['mathematics','science','social-science']))
          || (request.resource.data.requestedCourse == 'class8' && request.resource.data.accessPrice in [79,395])
          || (request.resource.data.requestedCourse == 'class10' && request.resource.data.accessPrice in [99,495])
          || (request.resource.data.requestedCourse in ['class11','class12'] && request.resource.data.accessPrice in [149,745])
          || (request.resource.data.requestedCourse == 'mbbs' && request.resource.data.accessPrice in [799,3995])
          || (request.resource.data.requestedCourse == 'jee' && request.resource.data.accessPrice in [499,2495])
          || (request.resource.data.requestedCourse == 'neetss' && request.resource.data.accessPrice == 0)
          || (request.resource.data.requestedCourse == 'neet'
            && request.resource.data.accessPrice in [99,495,499]
            && request.resource.data.neetExamYear in ['2027','2028']));
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.uid == resource.data.uid && request.resource.data.role == resource.data.role && request.resource.data.accessStatus == resource.data.accessStatus && request.resource.data.paymentStatus == resource.data.paymentStatus && request.resource.data.accessPrice == resource.data.accessPrice && request.resource.data.requestedCourse == resource.data.requestedCourse && request.resource.data.enrolledCourses == resource.data.enrolledCourses && request.resource.data.courseEntitlements == resource.data.courseEntitlements && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','activeCourse','updatedAt']) && (request.resource.data.activeCourse == resource.data.activeCourse || isAdmin() || (resource.data.courseEntitlements is map && request.resource.data.activeCourse in resource.data.courseEntitlements && resource.data.courseEntitlements[request.resource.data.activeCourse].status == 'active'));
      allow delete: if false;

      match /invoices/{invoiceId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create, update, delete: if false;
      }
    }

    // Publicly readable testimonials. Registered students own their verified
    // review. Guests may create one tightly constrained, unverified document;
    // guest reviews cannot be updated or self-labelled as verified.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if (signedIn()
        && request.auth.uid == reviewId
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && request.resource.data.uid == reviewId
        && request.resource.data.verifiedRegisteredStudent == true
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 1
        && request.resource.data.studentName.size() <= 80
        && request.resource.data.review is string
        && request.resource.data.review.size() >= 10
        && request.resource.data.review.size() <= 500
        && request.resource.data.keys().hasOnly(['uid','studentName','rating','review','verifiedRegisteredStudent','updatedAt']))
        || (request.auth == null
        && reviewId.matches('guest_[a-f0-9]{32}')
        && request.resource.data.uid == ''
        && request.resource.data.verifiedRegisteredStudent == false
        && request.resource.data.source == 'public'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 2
        && request.resource.data.studentName.size() <= 80
        && request.resource.data.review is string
        && request.resource.data.review.size() >= 10
        && request.resource.data.review.size() <= 500
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['uid','studentName','rating','review','verifiedRegisteredStudent','source','updatedAt']));
      allow update: if signedIn()
        && request.auth.uid == reviewId
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.verifiedRegisteredStudent == true
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 1
        && request.resource.data.studentName.size() <= 80
        && request.resource.data.review is string
        && request.resource.data.review.size() >= 10
        && request.resource.data.review.size() <= 500
        && request.resource.data.keys().hasOnly(['uid','studentName','rating','review','verifiedRegisteredStudent','updatedAt']);
      allow delete: if signedIn() && request.auth.uid == reviewId;
    }

    match /paymentRequests/{requestId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /neetssAccessRequests/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create, update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.courseId == 'neetss'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','courseId','status','requestedAt','updatedAt']);
      allow delete: if isAdmin();
    }

    match /neetssProgress/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create, update: if owns(uid) && hasNeetssAccess()
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','schemaVersion','completedModules','flashcards','bookmarks','attempts','mistakes','studyPlan','updatedAt']);
      allow delete: if false;
    }

    match /neetssCourseContent/{document=**} {
      allow read: if hasNeetssAccess();
      allow write: if isFounder();
    }

    // Authenticated students can see the learning leaderboard. Each student can write only their own row.
    // No email, phone or payment data belongs in this collection.
    match /leaderboard/{uid} {
      allow read: if hasActiveAccess() || isAdmin();
      allow create: if hasActiveAccess() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow update: if hasActiveAccess() && request.auth.uid == uid && request.resource.data.uid == resource.data.uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Private learning data used for cross-device progress, bookmarks and revision.
    // Payment and role fields are deliberately not permitted in this collection.
    match /learningProgress/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if hasActiveAccess() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'sessions', 'mistakes', 'bookmarks',
          'streak', 'weakTopics', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.sessions is list
        && request.resource.data.sessions.size() <= 40
        && request.resource.data.mistakes is list
        && request.resource.data.mistakes.size() <= 120
        && request.resource.data.bookmarks is list
        && request.resource.data.bookmarks.size() <= 100;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Mission 600 public catalogue documents contain metadata only. Question
    // papers, answer keys and paid content live in separately protected paths.
    match /mission600Series/{id} { allow read: if signedIn(); allow write: if isFounder(); }
    match /mission600Chapters/{id} { allow read: if signedIn(); allow write: if isFounder(); }
    match /mission600Calendar/{id} { allow read: if signedIn(); allow write: if isFounder(); }
    match /mission600Lectures/{id} { allow read: if signedIn(); allow write: if isFounder(); }
    match /mission600DPPs/{id} { allow read: if hasClass10Access(); allow write: if isFounder(); }
    match /mission600Tests/{id} { allow read: if hasClass10Access(); allow write: if isFounder(); }

    match /mission600DPPContent/{resourceId} {
      allow read: if isFounder() || (signedIn() && exists(/databases/$(database)/documents/mission600Entitlements/$(request.auth.uid + '_' + resourceId)));
      allow write: if isFounder();
    }
    match /mission600TestContent/{resourceId} {
      allow read: if isFounder() || (signedIn() && exists(/databases/$(database)/documents/mission600Entitlements/$(request.auth.uid + '_' + resourceId)));
      allow write: if isFounder();
    }
    match /mission600AnswerKeys/{resourceId} {
      allow read: if isFounder() || (signedIn()
        && resource.data.released == true
        && exists(/databases/$(database)/documents/mission600Entitlements/$(request.auth.uid + '_' + resourceId)));
      allow write: if isFounder();
    }

    match /mission600CartOrders/{orderId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isFounder());
      allow create, update, delete: if false;
    }
    match /mission600Purchases/{purchaseId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isFounder());
      allow create, update, delete: if false;
    }
    match /mission600Entitlements/{entitlementId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isFounder());
      allow create, update, delete: if false;
    }
    match /mission600Attempts/{attemptId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isFounder());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && hasClass10Access()
        && hasMissionEntitlement(request.resource.data.resourceId)
        && request.resource.data.keys().hasOnly(['uid','resourceId','status','answers','startedAt','updatedAt']);
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid
        && request.resource.data.resourceId == resource.data.resourceId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','answers','submittedAt','updatedAt']);
      allow delete: if false;
    }
    match /mission600Submissions/{submissionId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isFounder());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && hasClass10Access()
        && hasMissionEntitlement(request.resource.data.resourceId)
        && request.resource.data.keys().hasOnly(['uid','resourceId','attemptId','status','typedAnswers','files','createdAt','submittedAt','updatedAt']);
      allow update: if signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'draft'
        && request.resource.data.uid == resource.data.uid && request.resource.data.resourceId == resource.data.resourceId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','typedAnswers','files','submittedAt','updatedAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'draft';
    }
    match /mission600Results/{resultId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isFounder());
      allow write: if isFounder();
    }
    match /mission600StudentProgress/{uid} {
      allow read: if owns(uid) || isFounder();
      allow create, update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','weeklyCompletion','completedResources','mistakes','preferences','updatedAt']);
      allow delete: if false;
    }
    match /mission600Notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isFounder());
      allow create, delete: if isFounder();
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
